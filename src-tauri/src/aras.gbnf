root ::= (stmt "\n")* stmt?
stmt ::= type-stmt | group-stmt | node-stmt | conn-stmt | style-stmt

type-stmt ::= "@type: " ("architecture" | "flowchart")

group-stmt ::= "group \"" string "\" {\n" node-list "\n}"
node-list ::= (node-stmt "\n")* node-stmt?

node-stmt ::= "[" ident "]: \"" string "\""

conn-stmt ::= "[" ident "] --> [" ident "]" (": \"" string "\"")?

style-stmt ::= "style [" ident "] { " ident ": \"" string "\" }"

ident ::= [a-zA-Z0-9_-]+
string ::= [^"]+

